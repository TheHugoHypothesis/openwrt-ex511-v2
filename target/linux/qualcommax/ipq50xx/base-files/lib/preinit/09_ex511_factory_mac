# NSS snapshots the conduit's MAC before netifd starts. Apply the validated
# factory address before preinit networking or the NSS service can open it.
ex511_v2_preinit_mac() {
	[ "$(board_name)" = tplink,ex511-v2 ] || return 0
	local mac node
	. /lib/functions/system.sh
	. /lib/upgrade/nand.sh
	. /lib/functions/ex511-v2.sh
	mac=$(ex511_v2_get_factory_mac) || {
		echo "EX511: read-only factory MAC extraction failed" >&2
		return 0
	}
	node=$(readlink -f /sys/class/net/eth0/device/of_node)
	[ "${node##*/}" = ethernet@39d00000 ] || {
		echo "EX511: expected GMAC1 conduit not present" >&2
		return 0
	}
	ip link set dev eth0 address "$mac" || \
		echo "EX511: failed to set the conduit factory MAC before NSS" >&2
}
boot_hook_add preinit_main ex511_v2_preinit_mac
