#!/bin/sh
# preinit hook: mount the misc_data_ro UBI volume ("misc_ro") read-only so
# board.d/02_network and the ath11k caldata hotplug script can read the
# factory MAC address out of it.
#
# CONFIRMED on real hardware (ubiattach -O 2048, mount -t ubifs):
#   volume name: misc_ro
#   MAC file:    0x0434F100 (6 raw bytes, offset 0)
#
# Same offset on both MX515v and NX510v - this looks like a fixed layout in
# the shared vendor SDK these boards were built from, not a per-board
# coincidence.
#
# Unlike AX55/RE700X's tp_data/factory_data volume, this partition does NOT
# use human-readable filenames - files are named by raw internal address.
# This is confirmed from a live kernel UBIFS mount, not a guess.

. /lib/functions.sh

boot_hook_add preinit_main mount_misc_ro

mount_misc_ro() {
	# EX511 has its own validated factory-data mount/provisioning hook.
	# Do not attach its NAND twice through this MX515v helper.
	case "$(board_name)" in
	tplink,mx515v-v1) ;;
	*) return 0 ;;
	esac

	local mtdnum="$(find_mtd_index misc_data_ro)"

	[ -n "$mtdnum" ] || return 0

	mkdir -p /tmp/misc_ro

	if [ ! -e "/dev/ubi_ctrl" ]; then
		insmod ubi 2>/dev/null
	fi

	ubiattach -m "$mtdnum" 2>/dev/null

	local ubidev="$(grep -l "^${mtdnum}$" /sys/class/ubi/ubi*/mtd_num 2>/dev/null | sed 's#/mtd_num##; s#.*/##')"
	[ -n "$ubidev" ] || return 0

	mount -t ubifs -o ro "ubi${ubidev#ubi}:misc_ro" /tmp/misc_ro 2>/dev/null
}
